{
    "name": "quesoft/ntak-php",
    "description": "An easy to use NTAK PHP API / SDK (PHP 8.4+)",
    "version": "1.4.0",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "QueSoft IT",
            "email": "it@quesoft.hu"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.10",
        "nesbot/carbon": "^3.0",
        "gamegos/jws": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "ramsey/uuid": "^4.7"
    },
    "autoload": {
        "psr-4": {
            "QueSoft\\Ntak\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QueSoft\\Ntak\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
